# Copy to .env (chmod 600) and fill in. `.env` is gitignored — it never reaches the repo.
# In production the app refuses to start if a secret is missing or a placeholder.

# --- application -------------------------------------------------------------
# dev locally; deploy-prod.sh refuses anything but production on the server.
APP_ENV=dev                          # dev | production
# Each app on a shared host needs its own ports. APP_PORT_BLUE is also the initial proxy_pass port in
# deploy/nginx-mcp_stock_markets.conf — change both together.
APP_PORT_BLUE=8150
APP_PORT_GREEN=8151
# Sign-in links are built from this, never from the request's Host header. Production: https://<your domain>
APP_BASE_URL=http://localhost:8150

# Only for running the app outside Compose (uvicorn on the laptop): Compose builds
# its own DATABASE_URL from the DB_* values below and overrides this one.
DATABASE_URL=postgresql://user_mcp_stock_markets:CHANGE_ME_token_urlsafe_24@127.0.0.1:5550/db_mcp_stock_markets

# Fernet key sealing the owner's email and the language models' API keys at rest.
# KEEP A COPY OUTSIDE THE SERVER, beside the backup key: a restored backup's
# connections and account cannot be opened without it.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# The one person who may sign in, by emailed link, and whose portfolio the agent
# manages. Their account is made at startup and every other one is disabled.
# Empty: nobody can sign in, and there is no portfolio.
BOOTSTRAP_ADMIN_EMAIL=

# --- the game ------------------------------------------------------------------
# The cash the portfolio starts with, in dollars. Read once, when the portfolio
# is made (the first start): changing it later changes nothing.
STARTING_BUDGET=500
# How many S&P 500 companies the owner may put in the agent's market (1 to 25).
MAX_COMPANIES=5
# How often the agent runs while the US market is open, in minutes.
AGENT_INTERVAL_MINUTES=30

# --- market data -----------------------------------------------------------------
# Prices come from Google Finance (no key). Alpha Vantage gives the daily
# history and a fallback price; without a key the agent has neither.
# A free key (https://www.alphavantage.co/support/#api-key) allows 25 requests
# a day: the app fetches each company's history once a day.
ALPHA_VANTAGE_API_KEY=

# --- MCP ------------------------------------------------------------------------
# Where the agent reaches the app's MCP servers: the app's own port. Compose
# sets the container's own (http://127.0.0.1:8000) and overrides this one.
MCP_BASE_URL=http://127.0.0.1:8150
# The bearer token every MCP request must carry. Leave empty: each process makes
# its own and hands it to its agent. Set it only to connect another MCP client
# (the MCP Inspector, a desktop assistant) to a laptop's servers — never needed in production,
# where nginx keeps /mcp/ closed anyway.
MCP_TOKEN=

# --- database ----------------------------------------------------------------
DB_NAME=db_mcp_stock_markets
DB_USER=user_mcp_stock_markets
DB_PORT=5550                         # host loopback port, unique per app
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=CHANGE_ME_token_urlsafe_24

# --- email (magic links) -----------------------------------------------------
# The only outbound channel: sign-in is a link sent by email, never a password.
# Empty SMTP_HOST on a laptop writes the links to the log; production refuses it.
# Any SMTP relay with STARTTLS (Amazon SES credentials are region-bound).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=mcp-stock-markets@example.com
