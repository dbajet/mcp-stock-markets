# Copy to .env.backup (chmod 600). Only the backup sidecar receives it; deploy-prod.sh
# reads it as data to validate it. Deliberately separate from .env: a compromised
# app container cannot reach the S3 credentials.

DB_NAME=db_mcp_stock_markets
DB_USER=user_mcp_stock_markets
DB_PASSWORD=CHANGE_ME_same_value_as_app_env

# age public key every dump is sealed to before it touches disk. Generate the pair
# ON THE LAPTOP, never on the server:  age-keygen -o mcp_stock_markets-backup.key
# Only the public key (age1…) lives here, so a compromised server cannot read old
# backups. KEEP mcp_stock_markets-backup.key IN TWO PLACES OUTSIDE THE SERVER — without it
# every backup is unreadable.
BACKUP_AGE_RECIPIENT=CHANGE_ME_age1_public_key

BACKUP_INTERVAL_SECONDS=86400

# Dead-man's switch pinged after every successful backup (healthchecks.io, Uptime
# Kuma's push monitor, or any equivalent): set its period to the interval above and
# its alert to a person. It notifies when the pings stop — no SMTP credentials here.
BACKUP_HEARTBEAT_URL=CHANGE_ME_monitor_ping_url

# Least-privilege IAM user: PutObject on this bucket only. Retention is the
# bucket's lifecycle rule (e.g. expire daily/ after 90 days, keep monthly/).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_BACKUP_BUCKET=
S3_SSE=AES256
