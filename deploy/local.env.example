# Copy to deploy/local.env (gitignored) on the laptop that deploys. Read as data by
# deploy-from-local.sh, never sourced. A value may start with ~ for the home directory.

# The deploy user and host, as ssh takes them.
SERVER=deploy@app.example.com
# The private key for that user; empty to let ssh choose.
SSH_KEY=~/.ssh/id_ed25519
# A fine-grained GitHub token, this repository only, "Actions: Read", mode 600.
GITHUB_TOKEN_FILE=~/.config/mcp_stock_markets/github-ci-token
